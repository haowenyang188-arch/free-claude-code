# Native Codex execpolicy guardrails for this project.
#
# These rules deliberately contain no broad `allow` entries. An allow rule may
# run a matching command outside the sandbox, which would weaken the workspace
# boundary for generic commands such as cat, rg, or git. Low-risk reads stay in
# the configured sandbox; this file keeps known state-changing escalations
# interactive or forbidden after the project config layer is trusted.

prefix_rule(
    pattern = ["git", "reset"],
    decision = "forbidden",
    justification = "Git reset changes repository state and is blocked by the native policy.",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "Git clean deletes untracked files and is blocked by the native policy.",
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-pushing rewrites remote history and is blocked by the native policy.",
)

prefix_rule(
    pattern = ["git", "push", "--force-with-lease"],
    decision = "forbidden",
    justification = "Force-pushing rewrites remote history and is blocked by the native policy.",
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Recursive forced deletion is blocked by the native policy.",
)

prefix_rule(
    pattern = ["rm", "-fr"],
    decision = "forbidden",
    justification = "Recursive forced deletion is blocked by the native policy.",
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "Committing changes requires one-shot operator approval.",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Pushing changes requires one-shot operator approval.",
)

prefix_rule(
    pattern = ["git", "checkout"],
    decision = "prompt",
    justification = "Changing the checkout requires one-shot operator approval.",
)

prefix_rule(
    pattern = ["git", "switch"],
    decision = "prompt",
    justification = "Changing branches requires one-shot operator approval.",
)

prefix_rule(
    pattern = ["git", "merge"],
    decision = "prompt",
    justification = "Merging changes requires one-shot operator approval.",
)

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "prompt",
    justification = "Rebasing changes requires one-shot operator approval.",
)

prefix_rule(
    pattern = ["git", "cherry-pick"],
    decision = "prompt",
    justification = "Cherry-picking changes requires one-shot operator approval.",
)

prefix_rule(
    pattern = ["git", "stash"],
    decision = "prompt",
    justification = "Changing stash state requires one-shot operator approval.",
)

prefix_rule(
    pattern = ["git", "restore"],
    decision = "prompt",
    justification = "Restoring files requires one-shot operator approval.",
)

prefix_rule(
    pattern = ["git", "apply"],
    decision = "prompt",
    justification = "Applying a patch requires one-shot operator approval.",
)
