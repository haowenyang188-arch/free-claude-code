#!/usr/bin/env bash
# claude-pick — Launch Claude with free-claude-code's configured model
# Usage: claude-pick [extra claude args...]
#
# The historical filename is kept for compatibility. Model routing is controlled
# by MODEL/MODEL_* in .env; this wrapper configures the proxy URL and auth token.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${CLAUDE_PICK_ENV_FILE:-$SCRIPT_DIR/.env}"
PORT="${CLAUDE_PICK_PORT:-8082}"
BASE_URL="http://localhost:$PORT"

read_env_value() {
    local key="$1"
    [[ -f "$ENV_FILE" ]] || return 0

    local raw
    raw="$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$ENV_FILE" | tail -n 1 || true)"
    raw="${raw#*=}"
    raw="${raw%%#*}"
    raw="$(echo "$raw" | xargs || true)"
    raw="${raw%\"}"
    raw="${raw#\"}"
    raw="${raw%\'}"
    raw="${raw#\'}"
    echo "$raw"
}

model="${MODEL:-$(read_env_value MODEL)}"
model="${model:-minimax/MiniMax-M3}"
provider="${model%%/*}"

case "$provider" in
    minimax | deepseek) ;;
    *)
        echo "Error: Unsupported provider prefix in MODEL='$model'." >&2
        echo "Expected MODEL to start with minimax/ or deepseek/." >&2
        exit 1
        ;;
esac

# Read auth token from .env or environment
auth_token="${ANTHROPIC_AUTH_TOKEN:-$(read_env_value ANTHROPIC_AUTH_TOKEN)}"
if [[ -z "$auth_token" ]]; then
    auth_token="freecc"
fi

echo "Launching Claude with configured provider: $provider, model: $model" >&2
ANTHROPIC_AUTH_TOKEN="$auth_token" ANTHROPIC_BASE_URL="$BASE_URL" exec claude "$@"
