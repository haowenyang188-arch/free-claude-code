# DeepSeek Config
DEEPSEEK_API_KEY=""


# MiniMax Config
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimaxi.com/anthropic"


# DeepSeek Harness (optional; disabled by default)
DSH_ENABLED=false
# Optional OpenAI-compatible DeepSeek endpoint for the official runtime.
DEEPSEEK_BASE_URL=""
# Empty uses the pinned sandbox-capable Node runtime under harness/runtime.
# Override only with an explicit argv command; the bridge never invokes a shell.
# DSH_RUNTIME_COMMAND="node /absolute/path/to/free-claude-code/harness/runtime/runner.mjs"
DSH_RUNTIME_ARGS=""
# Empty uses the pinned sandbox-backed agent graph; set this for a custom graph.
DSH_CORDIS_CONFIG=""
# Empty while enabled selects the pinned default plugin allowlist. Custom
# configs must list every configured plugin, including the JSON-RPC server.
DSH_PLUGIN_ALLOWLIST=""
DSH_WORKSPACE_ROOT=""
DSH_RUNTIME_VERSION=""
DSH_REQUEST_TIMEOUT_SECONDS="120"
DSH_SHUTDOWN_TIMEOUT_SECONDS="5"
DSH_MAX_CONCURRENCY="1"
DSH_MAX_FRAME_BYTES="1048576"
DSH_MAX_STDERR_BYTES="65536"
DSH_MAX_TOKENS="49152"


# All Claude model requests are mapped to these models, plain model is fallback
# Format: provider_type/model/name
# Valid providers: "minimax" | "deepseek" | "dsh"
# DSH format: dsh/<provider>/<model>
MODEL_OPUS=
MODEL_SONNET=
MODEL_HAIKU=
MODEL="minimax/MiniMax-M3"


# Thinking output
# Global switch for provider reasoning requests and Claude thinking blocks.
# Set false to suppress thinking across all providers.
ENABLE_THINKING=true


# Provider config
# Per-provider proxy support: http and socks5, example: "http://username:password@host:port"
MINIMAX_PROXY=""

PROVIDER_RATE_LIMIT=40
PROVIDER_RATE_WINDOW=60
PROVIDER_MAX_CONCURRENCY=5


# HTTP client timeouts (seconds) for provider API requests
HTTP_READ_TIMEOUT=120
HTTP_WRITE_TIMEOUT=10
HTTP_CONNECT_TIMEOUT=2


# Loopback is the safe default. Non-loopback binds require API authentication.
HOST=127.0.0.1
PORT=8082
# Required when DSH_ENABLED=true or HOST is not loopback.
ANTHROPIC_AUTH_TOKEN=


# Messaging Platform: "telegram" | "discord"
MESSAGING_PLATFORM="discord"
MESSAGING_RATE_LIMIT=1
MESSAGING_RATE_WINDOW=1


# Voice Note Transcription
VOICE_NOTE_ENABLED=false
# WHISPER_DEVICE: "cpu" | "cuda"
# - "cpu"/"cuda": Hugging Face transformers Whisper (offline, free; install with: uv sync --extra voice_local)
WHISPER_DEVICE="cpu"
# WHISPER_MODEL:
# - For cpu/cuda: Hugging Face ID or short name (tiny, base, small, medium, large-v2, large-v3, large-v3-turbo)
WHISPER_MODEL="base"
HF_TOKEN=""


# Telegram Config
TELEGRAM_BOT_TOKEN=""
ALLOWED_TELEGRAM_USER_ID=""


# Discord Config
DISCORD_BOT_TOKEN=""
ALLOWED_DISCORD_CHANNELS=""


# Agent Config
# Select the local CLI backend used by the messaging adapter.
# Safe default: Claude in plan mode. Set AGENT_BACKEND=codex to run Codex CLI.
AGENT_BACKEND="claude"
# Claude permission mode. Keep "plan" unless an operator explicitly accepts writes.
AGENT_PERMISSION_MODE="plan"
# "proxy" keeps the repository's provider proxy behavior; "local" reuses
# credentials from `claude auth login` inside this WSL environment.
CLAUDE_AUTH_MODE="proxy"
# Codex CLI settings (used when AGENT_BACKEND=codex).
CODEX_BIN="codex"
CODEX_MODEL=""
CODEX_SANDBOX="read-only"
CODEX_APPROVAL_REQUIRED=true
CLAUDE_WORKSPACE="./agent_workspace"
ALLOWED_DIR=""
FAST_PREFIX_DETECTION=true
ENABLE_NETWORK_PROBE_MOCK=true
ENABLE_TITLE_GENERATION_SKIP=true
ENABLE_SUGGESTION_MODE_SKIP=true
ENABLE_FILEPATH_EXTRACTION_MOCK=true
